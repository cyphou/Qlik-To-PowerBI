[
  {
    "id": "KPI-Sales",
    "type": "kpi",
    "title": "Total Sales",
    "measures": [
      {
        "expression": "Sum(Amount)",
        "label": "Total Sales",
        "format": "$#,##0"
      }
    ],
    "dimensions": []
  },
  {
    "id": "KPI-Profit",
    "type": "kpi",
    "title": "Gross Profit",
    "measures": [
      {
        "expression": "Sum(Amount) - Sum(Cost)",
        "label": "Profit",
        "format": "$#,##0"
      }
    ],
    "dimensions": []
  },
  {
    "id": "KPI-Margin",
    "type": "kpi",
    "title": "Profit Margin",
    "measures": [
      {
        "expression": "(Sum(Amount) - Sum(Cost)) / Sum(Amount)",
        "label": "Margin",
        "format": "0.0%"
      }
    ],
    "dimensions": []
  },
  {
    "id": "KPI-Orders",
    "type": "kpi",
    "title": "Total Orders",
    "measures": [
      {
        "expression": "Count(DISTINCT OrderID)",
        "label": "Orders",
        "format": "#,##0"
      }
    ],
    "dimensions": []
  },
  {
    "id": "Sales-Trend",
    "type": "linechart",
    "title": "Sales Trend",
    "measures": [
      {
        "expression": "Sum(Amount)",
        "label": "Sales",
        "format": "$#,##0"
      }
    ],
    "dimensions": [
      {
        "field": "=Year(OrderDate) & '-' & Num(Month(OrderDate), '00')",
        "label": "Period"
      }
    ]
  },
  {
    "id": "Region-Bar",
