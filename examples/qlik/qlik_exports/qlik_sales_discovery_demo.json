  "loadscript": {
    "script": "SET ThousandSep=',';\nSET DecimalSep='.';\nSET MoneyFormat='$#,##0.00';\nSET DateFormat='MM/DD/YYYY';\nSET TimeFormat='hh:mm:ss';\n\n// ========== Section Access (RLS) ==========\nSection Access;\nLOAD * INLINE [\n  ACCESS, USERID, REGION\n  USER, admin@company.com, *\n  USER, east_mgr@company.com, East\n  USER, west_mgr@company.com, West\n  USER, central_mgr@company.com, Central\n  USER, south_mgr@company.com, South\n];\nSection Application;\n\n// ========== Calendar Table ==========\nCalendar:\nLOAD\n  Date,\n  Year(Date) as Year,\n  Month(Date) as Month,\n  Day(Date) as Day,\n  WeekDay(Date) as DayOfWeek,\n  'Q' & Ceil(Month(Date)/3) as Quarter,\n  Year(Date) & '-' & Num(Month(Date), '00') as YearMonth\n;\nLOAD\n  Date(MakeDate(2020) + IterNo() - 1) as Date\nAUTOGENERATE 2192;\n\n// ========== Sales ==========\nSales:\nLOAD\n  OrderID, OrderDate, CustomerID, ProductID, SalesRepID,\n  Quantity, UnitPrice, Discount, Amount, Cost,\n  ShipDate, ShipMode, Region\nFROM [data/Sales.csv] (txt, codepage is 1252, embedded labels, delimiter is ',');\n\n// ========== Customers ==========\nCustomers:\nLOAD\n  CustomerID, CustomerName, Segment, Country, State, City, PostalCode, Phone, Email\nFROM [data/Customers.xlsx] (ooxml, embedded labels, table is Customers);\n\n// ========== Products ==========\nProducts:\nSQL SELECT ProductID, ProductName, Category, SubCategory, Brand, UnitCost, ListPrice\nFROM ProductCatalog.dbo.Products;\n\n// ========== Sales Reps ==========\nSalesReps:\nLOAD SalesRepID, SalesRepName, Team, HireDate, ManagerName\nFROM [data/SalesReps.csv] (txt, codepage is 1252, embedded labels, delimiter is ',');\n\n// ========== Targets ==========\nTargets:\nLOAD Year, Month, Region, TargetAmount, TargetQuantity\nFROM [data/Targets.xlsx] (ooxml, embedded labels, table is Targets);\n\n// ========== Returns ==========\nReturns:\nLOAD ReturnID, OrderID, ReturnDate, ReturnReason, RefundAmount\nFROM [data/Returns.csv] (txt, codepage is 1252, embedded labels, delimiter is ',');\n\n// ========== Mapping Table for Ship Mode ==========\nShipModeMap:\nMAPPING LOAD * INLINE [\n  QlikMode, PBIMode\n  First Class, Priority\n  Second Class, Standard\n  Same Day, Express\n  Standard Class, Economy\n];\n\n// Apply mapping\nLET vShipMapped = ApplyMap('ShipModeMap', ShipMode, 'Unknown');"
  }
