{
  "defaults": {},
  "profiles": {
    "fast": {
      "mode": "import",
      "bridge_tables": "none",
      "output_format": "pbip"
    },
    "strict": {
      "mode": "import",
      "bridge_tables": "auto",
      "output_format": "pbip"
    },
    "regulated": {
      "mode": "import",
      "bridge_tables": "auto",
      "output_format": "pbip",
      "culture": "en-US"
    }
  },
  "entries": [
    {
      "file": "examples/qlik/test_samples/large/large_enterprise_sales.json",
      "profile": "regulated",
      "output_dir": "output/waves/enterprise_wave3/staging/Wave3-Enterprise"
    },
    {
      "file": "examples/qlik/qlik_exports/qlik_sales_discovery_demo.json",
      "profile": "regulated",
      "output_dir": "output/waves/enterprise_wave3/staging/Wave3-Discovery"
    },
    {
      "file": "examples/qlik/downloaded/sample_sales_from_qvf_downloaded.json",
      "profile": "strict",
      "output_dir": "output/waves/enterprise_wave3/staging/Wave3-Downloaded"
    }
  ]
}
