table Sales
	lineageTag: 2f02754b-e073-4fc7-b32e-d25fd3308c10

	measure 'CA Total' = SUM(Amount)
		formatString: #,0.00
		displayFolder: Measures
		lineageTag: e0e89f97-d6c7-4b95-8c69-ac80b15a0f6e

	measure 'Qté Totale' = SUM(Quantity)
		formatString: #,0.00
		displayFolder: Measures
		lineageTag: 92dae93c-1b28-4289-b2a0-b9160cf14562

	measure 'Année en cours' = "Year(Today())"
		lineageTag: afd71e39-924f-4474-81a9-5148124789d1

	column SaleID
		dataType: string
		lineageTag: 74ff4d4a-dc5d-4926-a4c8-2ea71f44a686
		summarizeBy: none
		sourceColumn: SaleID

		annotation SummarizationSetBy = Automatic

	column CustomerID
		dataType: string
		lineageTag: 02e894e4-7abf-45b7-9537-a0b40ecec461
		summarizeBy: none
		sourceColumn: CustomerID

		annotation SummarizationSetBy = Automatic

	column ProductID
		dataType: string
		lineageTag: a7321ebf-5e23-408e-ae02-e7d59a05fee1
		summarizeBy: none
		sourceColumn: ProductID

		annotation SummarizationSetBy = Automatic

	column OrderDate
		dataType: string
		lineageTag: 59dd1b92-61e4-492d-b386-b0f5c18c1255
		summarizeBy: none
		sourceColumn: OrderDate

		annotation SummarizationSetBy = Automatic

	column Amount
		dataType: string
		lineageTag: 5a96a0d2-5693-4171-b2ea-e68143a2c7ec
		summarizeBy: none
		sourceColumn: Amount

		annotation SummarizationSetBy = Automatic

	column Quantity
		dataType: string
		lineageTag: 31032a6f-4547-4861-aab6-36ecdace4c1d
		summarizeBy: none
		sourceColumn: Quantity

		annotation SummarizationSetBy = Automatic

	partition 'Sales-e9215f14-257e-4532-af0a-81847b4e64a0' = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents("Sales.csv"),[Delimiter=",", Columns=auto, Encoding=65001, QuoteStyle=QuoteStyle.None]),
				    PromotedHeaders = Table.PromoteHeaders(Source, [PromoteAllScalars=true])
				,\n    SelectedColumns = Table.SelectColumns(PromotedHeaders, {"SaleID", "CustomerID", "ProductID", "OrderDate", "Amount", "Quantity"})
				
				in
				    SelectedColumns

	annotation PBI_ResultType = Table

