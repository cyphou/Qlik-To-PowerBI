model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation PBI_QueryOrder = ["Orders","Customers","Products","SalesReps","Targets","Calendar"]

ref table Orders
ref table Customers
ref table Products
ref table SalesReps
ref table Targets
ref table Calendar

ref expression DataFolder

ref perspective 'Full Model'

