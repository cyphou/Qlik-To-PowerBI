model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation PBI_QueryOrder = ["Employees","Departments","Locations","Calendar"]

ref table Employees
ref table Departments
ref table Locations
ref table Calendar

ref expression DataFolder

ref perspective 'Full Model'

