table Sales
	lineageTag: 028a9795-5617-4ba9-a547-cb31caaa3ac2

	measure 'CA Total' = SUM('Sales'[Amount])
		formatString: #,0.00
		displayFolder: Measures
		lineageTag: 042418cf-48e1-40a8-b029-108a97e4645d

	measure 'Qté Totale' = SUM('Sales'[Quantity])
		formatString: #,0.00
		displayFolder: Measures
		lineageTag: f1922c92-b7b7-4d6a-bf5f-fea05bfc2167

	measure 'Année en cours' = "Year(Today())"
		lineageTag: 25dce2b6-a5ce-4f90-8747-cde58c83110a

	column SaleID
		dataType: int64
		lineageTag: 1dedadb4-1bb0-4416-9783-e50c1aea9c1b
		summarizeBy: none
		sourceColumn: SaleID

		annotation SummarizationSetBy = Automatic

	column CustomerID
		dataType: int64
		lineageTag: 335950a0-4520-4933-8eab-ed1f414cbac7
		summarizeBy: none
		sourceColumn: CustomerID

		annotation SummarizationSetBy = Automatic

	column ProductID
		dataType: int64
		lineageTag: e15f9a91-6dd0-4d1b-b93c-b088a17f1d64
		summarizeBy: none
		sourceColumn: ProductID

		annotation SummarizationSetBy = Automatic

	column OrderDate
		dataType: dateTime
		lineageTag: eb4f4765-1a65-443f-93da-15be0d7e8600
		summarizeBy: none
		sourceColumn: OrderDate

		annotation SummarizationSetBy = Automatic

	column Amount
		dataType: double
		lineageTag: 9e2dd17d-ff50-4d4e-b0c5-6d029dd0c185
		summarizeBy: none
		sourceColumn: Amount

		annotation SummarizationSetBy = Automatic

	column Quantity
		dataType: int64
		lineageTag: 2910f3ba-6aa5-4583-b497-c0bcc8241457
		summarizeBy: none
		sourceColumn: Quantity

		annotation SummarizationSetBy = Automatic

	partition 'Sales-d9cc3d81-936e-4f55-b348-9142e701ee9a' = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "\\Sales.csv"),[Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.None]),
				    PromotedHeaders = Table.PromoteHeaders(Source, [PromoteAllScalars=true])
				,
				    SelectedColumns = Table.SelectColumns(PromotedHeaders, {"SaleID", "CustomerID", "ProductID", "OrderDate", "Amount", "Quantity"})
				
				in
				    SelectedColumns

	annotation PBI_ResultType = Table

