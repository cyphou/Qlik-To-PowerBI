table Sales
	lineageTag: f72409a4-957d-48dd-9afc-1b8497d88540

	measure 'CA Total' = SUM(Amount)
		formatString: #,0.00
		displayFolder: Measures
		lineageTag: b9c2e6e5-f02f-44fe-b8bd-6acd6d8cd007

	measure 'Qté Totale' = SUM(Quantity)
		formatString: #,0.00
		displayFolder: Measures
		lineageTag: c86c35d2-81c0-4d9e-bd89-8a160db62f3f

	measure 'Année en cours' = "Year(Today())"
		lineageTag: f5878c35-d0e0-4a9f-a2ae-9cdfbd026c94

	column SaleID
		dataType: string
		lineageTag: 871a0aea-a396-43ba-b2f6-e4ee3cd90676
		summarizeBy: none
		sourceColumn: SaleID

		annotation SummarizationSetBy = Automatic

	column CustomerID
		dataType: string
		lineageTag: 9ac8a704-7e14-41f2-a2b1-ce9503b39c17
		summarizeBy: none
		sourceColumn: CustomerID

		annotation SummarizationSetBy = Automatic

	column ProductID
		dataType: string
		lineageTag: c8a13465-6ef1-409b-ae37-b28d6914cf2e
		summarizeBy: none
		sourceColumn: ProductID

		annotation SummarizationSetBy = Automatic

	column OrderDate
		dataType: string
		lineageTag: e3b10a21-1d52-4102-ab34-a09487d93c4b
		summarizeBy: none
		sourceColumn: OrderDate

		annotation SummarizationSetBy = Automatic

	column Amount
		dataType: string
		lineageTag: 3181d9d1-c515-47e0-86c9-9c013196b512
		summarizeBy: none
		sourceColumn: Amount

		annotation SummarizationSetBy = Automatic

	column Quantity
		dataType: string
		lineageTag: 54f01b3d-a869-4f32-ab56-3bc3d6519ebb
		summarizeBy: none
		sourceColumn: Quantity

		annotation SummarizationSetBy = Automatic

	partition 'Sales-8197c7f6-66ff-4a9f-b80f-f3a9e049ccbc' = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents("Sales.csv"),[Delimiter=",", Columns=auto, Encoding=65001, QuoteStyle=QuoteStyle.None]),
				    PromotedHeaders = Table.PromoteHeaders(Source, [PromoteAllScalars=true])
				,\n    SelectedColumns = Table.SelectColumns(PromotedHeaders, {"SaleID", "CustomerID", "ProductID", "OrderDate", "Amount", "Quantity"})
				
				in
				    SelectedColumns

	annotation PBI_ResultType = Table

