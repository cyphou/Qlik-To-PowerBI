table Sales
	lineageTag: 9a6256eb-6d87-4aeb-a356-cf28d6cbbc1a

	measure 'Total Sales' = SUM(Amount)
		formatString: #,0.00
		displayFolder: Measures
		lineageTag: e693f672-1ad3-42df-b01e-12036f56ff9a

	measure Qty = SUM(Quantity)
		formatString: #,0.00
		displayFolder: Measures
		lineageTag: 3611f18a-23d4-461e-a817-f3e81b5bb1d9

	measure Cost = SUM(Cost)
		formatString: #,0.00
		displayFolder: Measures
		lineageTag: aa6ef25b-17f8-48f0-9ee5-d42b0ed31326

	measure Profit = SUM(Amount) - SUM(Cost)
		formatString: #,0.00
		displayFolder: Measures
		lineageTag: c53b439e-5f65-4475-9f1a-6c1f5da547b9

	measure 'Margin %' = (SUM(Amount) - SUM(Cost)) / SUM(Amount)
		formatString: #,0.00
		displayFolder: Measures
		lineageTag: 3cff400d-1e95-4e2f-954c-7f5cd176b67b

	measure AOV = AVERAGE(Amount)
		formatString: #,0.00
		displayFolder: Measures
		lineageTag: d28c84a2-e960-4d0d-8391-913ba8ecb3ef

	measure Customers = COUNT(DISTINCT CustomerID)
		formatString: #,0.00
		displayFolder: Measures
		lineageTag: 881a718d-67f1-465a-a296-f0f0708dd787

	measure Orders = COUNT(DISTINCT OrderID)
		formatString: #,0.00
		displayFolder: Measures
		lineageTag: 3cf78fae-9124-4ecc-b00e-00086c3e14aa

	measure 'YTD Sales' = CALCULATE(SUM('Sales'[Amount]), 'Sales'[OrderDate] = ">=STARTOFYEAR(TODAY())<=TODAY()")
		formatString: #,0.00
		displayFolder: Measures
		lineageTag: 78439f3a-f2a2-4a06-b38a-617b53f444a7

	measure 'PY Sales' = CALCULATE(SUM('Sales'[Amount]), 'Sales'[Year] = "YEAR(TODAY())-1")
		formatString: #,0.00
		displayFolder: Measures
		lineageTag: 6ba3dadf-5632-4a73-842d-ffddf6930eee

	measure 'YoY %' = (SUM(Amount) - CALCULATE(SUM('Sales'[Amount]), 'Sales'[Year] = "YEAR(TODAY())-1")) / CALCULATE(SUM('Sales'[Amount]), 'Sales'[Year] = "YEAR(TODAY())-1")
		formatString: #,0.00
		displayFolder: Measures
		lineageTag: b54a2d63-19aa-4c8e-91d4-1ad345f92cce

	measure '% Target' = SUM(Amount) / SUM(TargetAmount)
		formatString: #,0.00
		displayFolder: Measures
		lineageTag: 11f1f7b1-b41f-49d7-a826-1782d6a7a997

	measure 'Return Rate' = COUNT(DISTINCT ReturnID) / COUNT(DISTINCT OrderID)
		formatString: #,0.00
		displayFolder: Measures
		lineageTag: 6b939507-77a5-4811-918e-98478bf7e608

	measure 'Avg Discount' = AVERAGE(Discount)
		formatString: #,0.00
		displayFolder: Measures
		lineageTag: 0a93de45-370b-44a4-959e-99495c5e3bcc

	measure 'Category Total' = SUMX(VALUES('Sales'[Category]), SUM(Amount))
		formatString: #,0.00
		displayFolder: Measures
		lineageTag: cf0a896c-8a70-4be4-a7b1-47c6af302d5d

	measure 'Running Total' = SUM(SUM(Amount)
		formatString: #,0.00
		displayFolder: Measures
		lineageTag: 56147e9c-34fe-4cad-a5aa-a9a5518d8c7d

	measure Rank = RANKX(ALL('Table'), SUM(Amount))
		formatString: #,0.00
		displayFolder: Measures
		lineageTag: fe7555d9-9580-4599-9d9c-b52bda821e6e

	measure 'Prev Month' = OFFSET(-1, ALLSELECTED('Sales'), ORDERBY(SUM(Amount))[SUM(Amount])
		formatString: #,0.00
		displayFolder: Measures
		lineageTag: 9b5514f6-f2d3-4780-b795-684869a53601

	measure Period = =YEAR(OrderDate) & '-' & VALUE(MONTH(OrderDate), '00')
		displayFolder: Dimensions
		lineageTag: 389c2d70-1905-4231-83a0-7b5ca4db15e8

	measure 'Revenue KPI' = SUM(Amount)
		displayFolder: Calculations
		lineageTag: daef8ce3-b6be-4036-8170-43cedd40ae83

	measure 'Profit KPI' = SUM(Amount) - SUM(Cost)
		displayFolder: Calculations
		lineageTag: 95bde262-f7e1-463c-a7ca-801f33a6aafe

	measure 'Customer Dim' = CustomerName
		displayFolder: Dimensions
		lineageTag: 064da733-fb3a-4301-9c7b-1a94a7cfd671

	measure 'Product Dim' = ProductName
		displayFolder: Dimensions
		lineageTag: e8986471-d2c9-41f5-a548-8a5184213979

	measure 'Sales from top 10 customers' = SUM({<CustomerName={">=SUMX(VALUES('Sales'[CustomerName]), SUM(Amount))[-10]"}>} Amount
		displayFolder: Calculations
		lineageTag: b7b5e3c9-05d7-43ce-94b1-7d3b4b0b1391

	measure 'Current year' = "Year(Today())"
		lineageTag: 308f4465-5e75-4560-999e-6cfba4130f7d

	measure 'Previous year' = "Year(Today()) - 1"
		lineageTag: c4e8aff9-2ddd-416a-acb3-3aca69d5702f

	measure '10% YoY growth target' = "0.10"
		lineageTag: 3ca0cc8a-c40c-4587-bcab-f5c54e79819d

	measure 'Minimum acceptable margin (20%)' = "0.20"
		lineageTag: 56240ddb-0522-4990-b7e1-fa9ab85fc54a

