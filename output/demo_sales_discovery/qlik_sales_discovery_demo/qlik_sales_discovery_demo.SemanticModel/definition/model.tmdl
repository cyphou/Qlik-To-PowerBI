model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation PBI_QueryOrder = ["Sales","Customers","Products","SalesReps","Returns","Targets","Calendar"]

ref table Sales
ref table Customers
ref table Products
ref table SalesReps
ref table Returns
ref table Targets
ref table Calendar

ref expression DataFolder

ref role RLS_admin
ref role RLS_east_mgr
ref role RLS_west_mgr
ref role RLS_central_mgr
ref role RLS_south_mgr

ref perspective 'Full Model'

