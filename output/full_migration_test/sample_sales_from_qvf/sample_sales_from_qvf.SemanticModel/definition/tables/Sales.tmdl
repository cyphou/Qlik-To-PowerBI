table Sales
	lineageTag: 5dc0bb3a-fb86-4f6a-be8f-1e15d8baf196

	measure 'CA Total' = SUM(Amount)
		formatString: #,0.00
		displayFolder: Measures
		lineageTag: b76f9cf6-5e8b-4562-b140-898840ab458b

	measure 'Qté Totale' = SUM(Quantity)
		formatString: #,0.00
		displayFolder: Measures
		lineageTag: b8d5ca8c-e544-4c3f-ae7c-5e0964441a2e

	measure 'Année en cours' = "Year(Today())"
		lineageTag: 8d477a11-f48f-46d7-af8d-1f93354ca980

	column SaleID
		dataType: string
		lineageTag: 07c2f0e1-929a-46be-85fc-e45e8cd041bf
		summarizeBy: none
		sourceColumn: SaleID

		annotation SummarizationSetBy = Automatic

	column CustomerID
		dataType: string
		lineageTag: 76a005f8-5ceb-4b92-b4a6-a3ee0f181149
		summarizeBy: none
		sourceColumn: CustomerID

		annotation SummarizationSetBy = Automatic

	column ProductID
		dataType: string
		lineageTag: 3f00cc7b-50df-4b44-ad0e-4c1b603817d0
		summarizeBy: none
		sourceColumn: ProductID

		annotation SummarizationSetBy = Automatic

	column OrderDate
		dataType: string
		lineageTag: fee6df9e-62a6-48e5-9e15-82b65ce7c650
		summarizeBy: none
		sourceColumn: OrderDate

		annotation SummarizationSetBy = Automatic

	column Amount
		dataType: string
		lineageTag: a4ee3cf3-296d-4e53-83ce-bf799e105ee5
		summarizeBy: none
		sourceColumn: Amount

		annotation SummarizationSetBy = Automatic

	column Quantity
		dataType: string
		lineageTag: 6975f48f-6d0d-4cb5-83bc-7e419acc85c4
		summarizeBy: none
		sourceColumn: Quantity

		annotation SummarizationSetBy = Automatic

	partition 'Sales-52c8c65c-f0a4-45c6-b8af-590afefad0da' = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents("Sales.csv"),[Delimiter=",", Columns=auto, Encoding=65001, QuoteStyle=QuoteStyle.None]),
				    PromotedHeaders = Table.PromoteHeaders(Source, [PromoteAllScalars=true])
				,
				    SelectedColumns = Table.SelectColumns(PromotedHeaders, {"SaleID", "CustomerID", "ProductID", "OrderDate", "Amount", "Quantity"})
				
				in
				    SelectedColumns

	annotation PBI_ResultType = Table

