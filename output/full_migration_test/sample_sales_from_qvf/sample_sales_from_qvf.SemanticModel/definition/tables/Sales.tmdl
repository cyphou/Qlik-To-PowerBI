table Sales
	lineageTag: 1b6d7c19-097a-46b4-83f4-ed3df76b74ca

	measure 'CA Total' = SUM(Amount)
		formatString: #,0.00
		displayFolder: Measures
		lineageTag: bed7d37a-528c-4e6e-a71b-eee9888e1834

	measure 'Qté Totale' = SUM(Quantity)
		formatString: #,0.00
		displayFolder: Measures
		lineageTag: de534e7c-9248-444c-8e49-e657089f76a5

	measure 'Année en cours' = "Year(Today())"
		lineageTag: 6adbd83c-4d6a-4736-b382-0c1696fe6dd3

	column SaleID
		dataType: string
		lineageTag: 521c6347-7d90-468f-a02f-0e1add88408e
		summarizeBy: none
		sourceColumn: SaleID

		annotation SummarizationSetBy = Automatic

	column CustomerID
		dataType: string
		lineageTag: 922f666d-5d86-4d3a-975a-cbfd8f2d06ad
		summarizeBy: none
		sourceColumn: CustomerID

		annotation SummarizationSetBy = Automatic

	column ProductID
		dataType: string
		lineageTag: 1768f368-d2fc-4246-985f-939a7c468d0d
		summarizeBy: none
		sourceColumn: ProductID

		annotation SummarizationSetBy = Automatic

	column OrderDate
		dataType: string
		lineageTag: 6d6b4f5b-08be-46da-be2b-dca7b9979526
		summarizeBy: none
		sourceColumn: OrderDate

		annotation SummarizationSetBy = Automatic

	column Amount
		dataType: string
		lineageTag: cd9375f5-d7cb-4519-86cf-3dba4485db06
		summarizeBy: none
		sourceColumn: Amount

		annotation SummarizationSetBy = Automatic

	column Quantity
		dataType: string
		lineageTag: 1a573e6d-9724-471c-89c3-d02ab5db574e
		summarizeBy: none
		sourceColumn: Quantity

		annotation SummarizationSetBy = Automatic

	partition 'Sales-a60494dd-a4be-4d77-b98c-66d1ac22b9dd' = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents("Sales.csv"),[Delimiter=",", Columns=auto, Encoding=65001, QuoteStyle=QuoteStyle.None]),
				    PromotedHeaders = Table.PromoteHeaders(Source, [PromoteAllScalars=true])
				,
				    SelectedColumns = Table.SelectColumns(PromotedHeaders, {"SaleID", "CustomerID", "ProductID", "OrderDate", "Amount", "Quantity"})
				
				in
				    SelectedColumns

	annotation PBI_ResultType = Table

