model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation PBI_QueryOrder = ["Sales","Customers","Products"]

ref table Sales
ref table Customers
ref table Products

ref expression DataFolder

ref perspective 'Full Model'

